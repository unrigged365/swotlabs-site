# Contact form email delivery (Resend — https://resend.com).
# When unset, the /api/contact endpoint validates and logs the lead
# server-side but does not send an email (form still succeeds in dev).
RESEND_API_KEY=

# Where contact-form leads are delivered. Defaults to hello@swotlabs.com.
CONTACT_TO_EMAIL=hello@swotlabs.com

# Verified sender for Resend. Defaults to Resend's onboarding sandbox address.
CONTACT_FROM_EMAIL="SwotLabs Site <onboarding@resend.dev>"
